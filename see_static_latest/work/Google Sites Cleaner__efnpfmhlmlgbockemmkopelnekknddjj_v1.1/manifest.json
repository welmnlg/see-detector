{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Google Sites Cleaner",
  "version": "1.1",
  "description": "Closes tabs on sites.google.com that contain signs they are not educational",
  "permissions": [
    "tabs"
  ],
    "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sites.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}