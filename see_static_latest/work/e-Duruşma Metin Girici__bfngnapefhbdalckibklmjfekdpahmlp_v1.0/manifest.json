{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "e-Duruşma Metin Girici",
  "version": "1.0",
  "description": "UYAP Avukat Portalı e-Duruşma talep formuna otomatik metin ekler",
  "permissions": [
    "geolocation",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://avukat.uyap.gov.tr/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}