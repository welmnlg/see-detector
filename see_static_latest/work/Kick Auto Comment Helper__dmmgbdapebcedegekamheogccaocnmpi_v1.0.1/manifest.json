{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Kick Auto Comment Helper",
  "description": "Kick配信で定型コメントを安全な間隔で送信するための補助ツールです。ユーザー操作による開始・停止が可能です。",
  "version": "1.0.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["https://kick.com/*"],
      "js": ["content.js"]
    }
  ]
}
