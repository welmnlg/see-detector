{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "SOOP 댓글 링크 복사",
  "version": "2.0",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["*://*.sooplive.com/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.sooplive.com/*"]
    }
  ]
}